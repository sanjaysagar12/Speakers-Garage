{
  "name": "shoreline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "tsx scripts/build-assets.ts",
    "map": "tsx scripts/gen-map.ts",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "shots": "node scripts/shots.mjs",
    "typecheck": "tsc --noEmit",
    "test:movement": "vitest run tests/movement.test.ts",
    "size": "node scripts/size-report.mjs dist",
    "perf": "node scripts/perf.mjs",
    "pier-check": "node scripts/pier-check.mjs",
    "analyze": "ANALYZE=1 vite build"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "easystarjs": "^0.4.4",
    "phaser": "^3.90.0",
    "postprocessing": "^6.37.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.172.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "rollup-plugin-visualizer": "^5.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vitest": "^3.2.4"
  }
}

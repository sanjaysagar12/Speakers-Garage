{
  "name": "speakers-garage",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "pnpm --filter @speakersgarage/server start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:fit": "pnpm --filter @speakersgarage/web test:fit",
    "test:movement": "pnpm --filter @speakersgarage/shared exec vitest run tests/movement.test.ts"
  },
  "devDependencies": {
    "@speakersgarage/config": "workspace:*",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13"
  }
}

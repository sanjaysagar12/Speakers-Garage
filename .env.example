# Copy to apps/server/.env and/or apps/web/.env (each app reads its own). Everything has a working
# default for local development, so none of this is needed for `pnpm dev`.

# ---------------- apps/server/.env ----------------
# PORT=8787
# HOST=0.0.0.0
# NODE_ENV=development            # development also accepts LAN origins (phones on your Wi-Fi)
# LOG_LEVEL=info
# Browser origins allowed to connect (comma separated). Production: your web app's origin(s).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TICK_RATE=20                     # simulation + snapshot rate (Hz)
# MAX_PLAYERS_PER_ROOM=50
# MAX_ROOMS=200
# AOI_RADIUS=40                    # metres: players further away are not sent
# DEFAULT_MAP=beach                # beach | vinland (a new room's map when the client doesn't say)
# WS_CONNECTS_PER_MINUTE=30        # WebSocket connects per IP per minute
# Voice: STUN fallback, and TURN for players on different networks (see infra/coturn/turnserver.conf)
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=same-value-as-static-auth-secret-in-turnserver.conf
# TURN_TTL_SECONDS=3600

# ---------------- apps/web/.env ----------------
# Game server WebSocket URL. Leave unset in development: the Vite dev/preview server proxies /ws and
# /api to the game server (GAME_SERVER, default http://127.0.0.1:8787), so the page uses its own origin.
# VITE_SERVER_URL=wss://game.example.com/ws

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "fastify",
      "entrypoint": "src/index.ts",
      "buildCommand": "pnpm --filter @speakersgarage/shared build"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "pnpm exec vite build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    { "source": "/ws", "destination": { "service": "server" } },
    { "source": "/rooms", "destination": { "service": "server" } },
    { "source": "/health", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
